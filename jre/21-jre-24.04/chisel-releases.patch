diff --git a/slices/libsctp1.yaml b/slices/libsctp1.yaml
new file mode 100644
--- /dev/null
+++ b/slices/libsctp1.yaml
@@ -0,0 +1,15 @@
+package: libsctp1
+
+essential:
+  - libsctp1_copyright
+
+slices:
+  libs:
+    essential:
+      - libc6_libs
+    contents:
+      /usr/lib/*-linux-*/libsctp.so.1*:
+
+  copyright:
+    contents:
+      /usr/share/doc/libsctp1/copyright:
